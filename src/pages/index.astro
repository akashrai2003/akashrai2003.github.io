---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KvCache from '../components/KvCache.astro';
import { getPosts, formatDate, postUrl } from '../lib/posts';
import { siteConfig } from '../data/siteConfig';
import { caseStudies } from '../data/caseStudies';

const posts = await getPosts();
const [lead, ...rest] = posts;
const more = rest.slice(0, 4);

const work = ['indian-navy-platform', 'salesforce-saql-analytics', 'inkwell-desktop-ide']
  .map((slug) => caseStudies.find((c) => c.slug === slug))
  .filter((c) => c !== undefined);

const numbers = [
  { value: '22K→40K', label: 'context length', note: 'Ministral-3-8B FP8 on a 16 GB Blackwell card, via FP8 KV cache' },
  { value: '~750', label: 'tokens / sec', note: 'aggregate output across batches of 10–20 requests' },
  { value: '10×', label: 'cheaper RAG', note: 'replaced a managed RAG service with a custom retrieval cascade' },
  { value: '12K★', label: 'kepler.gl', note: 'merged PR #3262 fixing stale LLM state in the AI assistant' }
];

const now = [
  {
    label: 'Shipping',
    title: 'Air-gapped document intelligence',
    body: 'On-prem LLM platform for defence: OCR, retrieval, agents and vLLM serving with zero internet access.'
  },
  {
    label: 'Building',
    title: 'Inkwell',
    body: 'A local-first desktop IDE for reading technical PDFs, where every AI note links back to the exact spot on the page.'
  },
  {
    label: 'Learning',
    title: 'C++ and CUDA',
    body: 'Going below the Python layer to understand inference runtimes and kernels from first principles.'
  }
];
---

<Base>
  <section class="hero container-wide">
    <div class="hero-text">
      <p class="kicker kicker-accent">AI engineer · Bengaluru</p>
      <h1>
        Hi, I'm Akash. I make LLMs run <em>fast</em>, <em>private</em> and useful, from retrieval down to the GPU.
      </h1>
      <p class="lede">
        I build on-prem and air-gapped GenAI systems at Inferigence Quotient: document intelligence, agentic workflows, and
        vLLM inference tuned on Blackwell GPUs. This site is where I write up what I learn shipping them.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/blog/">Read the writing <Icon name="arrowRight" /></a>
        <a class="btn" href={siteConfig.resumeUrl}><Icon name="file" /> Résumé</a>
        <span class="socials">
          <a href={siteConfig.github} aria-label="GitHub"><Icon name="github" /></a>
          <a href={siteConfig.linkedin} aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a href={`mailto:${siteConfig.email}`} aria-label="Email"><Icon name="mail" /></a>
        </span>
      </div>
    </div>
    <div class="hero-visual">
      <KvCache />
      <p class="visual-note">
        What I think about all day: a paged KV cache. Requests grab free blocks wherever they are, grow token by token, and
        hand memory back when they finish.
      </p>
    </div>
  </section>

  <section class="numbers container-wide" aria-label="Selected results">
    {
      numbers.map((n) => (
        <div class="stat">
          <p class="stat-value">{n.value}</p>
          <p class="stat-label">{n.label}</p>
          <p class="stat-note">{n.note}</p>
        </div>
      ))
    }
  </section>

  <section class="container-wide block">
    <div class="block-head">
      <h2>Latest writing</h2>
      <a href="/blog/">All posts <Icon name="arrowRight" /></a>
    </div>
    <div class="writing">
      {
        lead && (
          <a class="lead-post" href={postUrl(lead)}>
            <span class="kicker kicker-accent">{lead.data.category ?? 'Latest'}</span>
            <span class="lead-title">{lead.data.title}</span>
            <span class="lead-desc">{lead.data.description}</span>
            <span class="kicker">{formatDate(lead.data.pubDate)}</span>
          </a>
        )
      }
      <ol class="post-rows">
        {
          more.map((p) => (
            <li>
              <a href={postUrl(p)}>
                <span class="row-title">{p.data.title}</span>
                <span class="kicker">
                  {formatDate(p.data.pubDate, 'short')}
                  {p.data.category && ` · ${p.data.category}`}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head">
      <h2>Right now</h2>
    </div>
    <div class="now">
      {
        now.map((n) => (
          <div class="now-item">
            <p class="kicker kicker-accent">{n.label}</p>
            <h3>{n.title}</h3>
            <p>{n.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head">
      <h2>Selected work</h2>
      <a href="/projects/">All projects <Icon name="arrowRight" /></a>
    </div>
    <div class="work">
      {
        work.map((c) => (
          <a class="work-card" href={`/projects/${c.slug}/`}>
            <span class="kicker">{c.category}</span>
            <span class="work-title">{c.title}</span>
            <span class="work-sub">{c.subtitle}</span>
            <span class="work-tags">
              {c.tags.slice(0, 3).map((t) => (
                <span class="tag">{t}</span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container-wide block">
    <div class="contact">
      <div>
        <h2>Let's talk</h2>
        <p>
          Open to AI systems and inference engineering roles (remote or Bengaluru), and to comparing notes with anyone running
          LLMs on their own hardware.
        </p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-primary" href={`mailto:${siteConfig.email}`}><Icon name="mail" /> {siteConfig.email}</a>
        <a class="btn" href={siteConfig.linkedin}><Icon name="linkedin" /> LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Redirect links from the old hash-routed site (#post/slug, #writing…) to real URLs.
  const legacy = location.hash.replace(/^#\/?/, '');
  const map: Record<string, string> = {
    writing: '/blog/',
    projects: '/projects/',
    'case-studies': '/projects/',
    experience: '/experience/',
    stack: '/experience/'
  };
  if (legacy.startsWith('post/')) location.replace(`/blog/${legacy.slice(5)}/`);
  else if (map[legacy]) location.replace(map[legacy]);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding-block: 4.5rem 3.5rem;
  }

  h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.06;
    margin: 0.9rem 0 1.25rem;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .lede {
    font-size: 1.1rem;
    color: var(--text-2);
    max-width: 34rem;
    margin: 0 0 1.75rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .socials {
    display: inline-flex;
    gap: 0.15rem;
    margin-left: 0.4rem;
  }

  .socials a {
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .socials a:hover {
    color: var(--accent);
    background: var(--bg-soft);
  }

  .visual-note {
    margin: 0.85rem 0.25rem 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--border);
  }

  .stat {
    padding: 1.6rem 1.25rem 1.5rem;
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat p {
    margin: 0;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-top: 0.35rem !important;
  }

  .stat-note {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.5rem !important;
    line-height: 1.45;
  }

  .block {
    padding-top: 4.5rem;
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .block-head h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .block-head a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .writing {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2rem;
  }

  .lead-post {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border-radius: 16px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .lead-post:hover {
    border-color: var(--accent);
  }

  .lead-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .lead-desc {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text-2);
    flex: 1;
  }

  .post-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-rows a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .post-rows li:first-child a {
    padding-top: 0;
  }

  .row-title {
    font-weight: 600;
    line-height: 1.4;
  }

  .post-rows a:hover .row-title,
  .work-card:hover .work-title {
    color: var(--accent);
  }

  .now {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .now-item {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .now-item h3 {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.15rem;
  }

  .now-item > p:last-child {
    margin: 0;
    color: var(--text-2);
    font-size: 0.92rem;
  }

  .work {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .work-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .work-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .work-sub {
    font-size: 0.88rem;
    color: var(--text-2);
    flex: 1;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: 18px;
    background: var(--text);
    color: var(--bg);
  }

  .contact h2 {
    margin: 0 0 0.4rem;
    color: var(--bg);
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }

  .contact p {
    margin: 0;
    max-width: 34rem;
    color: color-mix(in srgb, var(--bg) 75%, transparent);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact .btn {
    background: transparent;
    color: var(--bg);
    border-color: color-mix(in srgb, var(--bg) 35%, transparent);
  }

  .contact .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .contact .btn:hover {
    border-color: var(--bg);
    color: var(--bg);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 3rem;
    }
    .numbers {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat:nth-child(3) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
    .writing,
    .now,
    .work {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .stat {
      padding: 1.25rem 0.75rem;
    }
    .stat-value {
      font-size: 1.6rem;
    }
    .socials {
      margin-left: 0;
    }
    .lead-post,
    .contact {
      padding: 1.4rem;
    }
  }
</style>

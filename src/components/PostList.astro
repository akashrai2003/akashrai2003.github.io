---
import { formatDate, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Group under year headings (blog index). */
  byYear?: boolean;
  showDescription?: boolean;
}

const { posts, byYear = false, showDescription = true } = Astro.props;

const groups: Array<[string, Post[]]> = byYear
  ? Object.entries(
      posts.reduce<Record<string, Post[]>>((acc, p) => {
        const y = String(p.data.pubDate.getUTCFullYear());
        (acc[y] ??= []).push(p);
        return acc;
      }, {})
    ).sort(([a], [b]) => Number(b) - Number(a))
  : [['', posts]];
---

{
  groups.map(([year, items]) => (
    <section class="group">
      {year && <h2 class="year">{year}</h2>}
      <ol class="posts">
        {items.map((post) => (
          <li class="post">
            <a href={postUrl(post)}>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'short')}</time>
              <span class="title">
                {post.data.title}
                {post.data.draft && <span class="draft">draft</span>}
              </span>
              {showDescription && <span class="desc">{post.data.description}</span>}
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))
}

<style>
  .group + .group {
    margin-top: 2.5rem;
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post a {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    column-gap: 1.25rem;
    row-gap: 0.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .post:last-child a {
    border-bottom: 1px solid var(--border);
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    padding-top: 0.2rem;
    white-space: nowrap;
  }

  .title {
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--text);
    text-wrap: pretty;
  }

  .desc {
    grid-column: 2;
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .post a:hover .title {
    color: var(--accent);
  }

  .draft {
    margin-left: 0.5rem;
    font: 500 0.7rem var(--font-mono);
    color: var(--callout-warning);
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    vertical-align: middle;
  }

  @media (max-width: 560px) {
    .post a {
      grid-template-columns: 1fr;
    }
    .desc {
      grid-column: 1;
    }
    time {
      padding-top: 0;
    }
  }
</style>

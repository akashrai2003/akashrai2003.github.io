---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<img class="logo" src="/logo.png" width={size} height={size} alt="" aria-hidden="true" />

<style>
  .logo {
    border-radius: 7px;
    background: #040804;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
</style>

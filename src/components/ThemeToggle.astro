---
import Icon from './Icon.astro';
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
  <Icon name="moon" class="icon icon-moon" />
  <Icon name="sun" class="icon icon-sun" />
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    font-size: 1rem;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle :global(.icon-sun) {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-sun) {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-moon) {
    display: none;
  }
</style>

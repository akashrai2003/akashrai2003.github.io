---
import Icon from './Icon.astro';

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const targets = [
  { label: 'LinkedIn', icon: 'linkedin' as const, href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { label: 'X', icon: 'x' as const, href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { label: 'Hacker News', icon: 'external' as const, href: `https://news.ycombinator.com/submitlink?u=${u}&t=${t}` }
];
---

<div class="share">
  <span class="label">Share</span>
  {
    targets.map((s) => (
      <a class="btn" href={s.href} target="_blank" rel="noopener noreferrer">
        <Icon name={s.icon} />
        {s.label}
      </a>
    ))
  }
  <button class="btn" type="button" data-copy-link={url}>
    <Icon name="link" />
    <span>Copy link</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span');
      try {
        await navigator.clipboard.writeText(btn.dataset.copyLink ?? location.href);
        if (label) label.textContent = 'Copied!';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => label && (label.textContent = 'Copy link'), 1800);
    });
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-right: 0.25rem;
  }

  .btn {
    font-size: 0.82rem;
    padding: 0.5rem 0.75rem;
  }
</style>
